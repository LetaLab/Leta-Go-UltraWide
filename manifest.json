{
  "manifest_version": 3,
  "name": "Leta Go UltraWide",
  "version": "0.5.0",
  "description": "Finds black bars around a playing video and crops, zooms, or stretches it to fill the screen.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["shared-constants.js", "content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Leta Go UltraWide",
    "default_icon": {
      "16": "icons/LetaGoUltraWide-16.png",
      "32": "icons/LetaGoUltraWide-32.png",
      "48": "icons/LetaGoUltraWide-48.png",
      "128": "icons/LetaGoUltraWide-128.png"
    }
  },
  "icons": {
    "16": "icons/LetaGoUltraWide-16.png",
    "32": "icons/LetaGoUltraWide-32.png",
    "48": "icons/LetaGoUltraWide-48.png",
    "128": "icons/LetaGoUltraWide-128.png"
  }
}
